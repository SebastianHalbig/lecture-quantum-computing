\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (0, 0) {};
		\node [style=none] (1) at (3, 0) {};
		\node [style=Hadamard] (2) at (1.5, 0) {};
		\node [style=none] (3) at (-0.75, 0.75) {};
		\node [style=none] (4) at (-0.75, -0.75) {};
		\node [style=none] (5) at (-0.75, -1.25) {};
		\node [style=none] (6) at (3.75, 0.75) {};
		\node [style=none] (7) at (3.75, -0.75) {};
		\node [style=none] (8) at (3.75, -1.25) {};
		\node [style=none] (9) at (1.5, -1) {The Hadamard gate};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (3.center) to (6.center);
