\begin{tikzpicture}[baseline={([yshift=-1ex]current bounding box.center)}]
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (1.5, 0) {};
		\node [style=none] (2) at (0, 1.5) {};
		\node [style=none] (3) at (1.5, 1.5) {};
		\node [style=none] (5) at (0, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=object, decoration={markings, mark=at position 0.3 with {\arrow{>}}}, postaction=decorate, in=360, out=180] (0.center) to (2.center);
		\draw [style=object, decoration={markings, mark=at position 0.3 with {\arrow{>}}}, postaction=decorate, in=0, out=-180] (3.center) to (5.center);
	\end{pgfonlayer}
\end{tikzpicture}
